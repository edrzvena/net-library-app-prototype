@inherits LayoutComponentBase
@implements IDisposable

<div class="page">
    <div class="sidebar">
        <NavMenu/>
    </div>

    <main>
        <div class="top-row px-4">
            <a href="loans/borrow" class="btn btn-sm btn-primary">
                <i class="bi bi-plus-lg"></i> Pinjam Buku
            </a>
        </div>

        <article class="content px-4">
            @* Kalau ada exception yang lolos dari halaman, tampilkan Error.razor
               daripada memutus circuit tanpa penjelasan. *@
            <ErrorBoundary @ref="_errorBoundary" @key="_currentUrl">
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent>
                    <Error/>
                </ErrorContent>
            </ErrorBoundary>
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Terjadi kesalahan yang tidak tertangani.
    <a href="." class="reload">Muat ulang</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    [Inject] private NavigationManager Nav { get; set; } = null!;

    private ErrorBoundary? _errorBoundary;
    private string _currentUrl = string.Empty;

    protected override void OnInitialized()
    {
        _currentUrl = Nav.Uri;
        Nav.LocationChanged += OnLocationChanged;
    }

    // Tanpa ini, sekali error boundary kepicu, seluruh sisa sesi ikut menampilkan halaman error.
    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _currentUrl = e.Location;
        _errorBoundary?.Recover();
        StateHasChanged();
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
