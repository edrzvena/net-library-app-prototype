@if (TotalPages > 1)
{
    <nav class="d-flex flex-wrap justify-content-between align-items-center gap-2">
        <small class="text-muted">
            Menampilkan @FirstItem–@LastItem dari @TotalCount data
        </small>

        <ul class="pagination pagination-sm mb-0">
            <li class="page-item @(Page <= 1 ? "disabled" : null)">
                <button class="page-link" @onclick="() => GoToAsync(Page - 1)">Sebelumnya</button>
            </li>

            @foreach (var p in VisiblePages())
            {
                <li class="page-item @(p == Page ? "active" : null)">
                    <button class="page-link" @onclick="() => GoToAsync(p)">@p</button>
                </li>
            }

            <li class="page-item @(Page >= TotalPages ? "disabled" : null)">
                <button class="page-link" @onclick="() => GoToAsync(Page + 1)">Berikutnya</button>
            </li>
        </ul>
    </nav>
}

@code {
    [Parameter] public int Page { get; set; } = 1;
    [Parameter] public int PageSize { get; set; } = 10;
    [Parameter] public int TotalCount { get; set; }
    [Parameter] public EventCallback<int> OnPageChanged { get; set; }

    private int TotalPages => PageSize <= 0 ? 0 : (int)Math.Ceiling(TotalCount / (double)PageSize);
    private int FirstItem => TotalCount == 0 ? 0 : (Page - 1) * PageSize + 1;
    private int LastItem => Math.Min(Page * PageSize, TotalCount);

    // Tampilkan maksimal 5 nomor halaman di sekitar halaman aktif.
    private IEnumerable<int> VisiblePages()
    {
        const int window = 5;
        var start = Math.Max(1, Page - window / 2);
        var end = Math.Min(TotalPages, start + window - 1);
        start = Math.Max(1, end - window + 1);

        for (var p = start; p <= end; p++) yield return p;
    }

    private async Task GoToAsync(int page)
    {
        if (page < 1 || page > TotalPages || page == Page) return;
        await OnPageChanged.InvokeAsync(page);
    }
}
