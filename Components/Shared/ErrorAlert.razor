@if (!string.IsNullOrWhiteSpace(Message))
{
    <div class="alert alert-danger alert-dismissible d-flex align-items-start gap-2" role="alert">
        <i class="bi bi-exclamation-triangle-fill mt-1"></i>
        <div>
            @* Pesan sudah berbahasa Indonesia dari service — komponen ini tidak menyusun teks sendiri. *@
            @Message
            @if (!string.IsNullOrWhiteSpace(Code))
            {
                <div class="small text-muted mt-1">Kode aturan: @Code</div>
            }
        </div>
        <button type="button" class="btn-close" aria-label="Tutup" @onclick="DismissAsync"></button>
    </div>
}

@code {
    [Parameter] public string? Code { get; set; }
    [Parameter] public string? Message { get; set; }
    [Parameter] public EventCallback OnDismiss { get; set; }

    private Task DismissAsync() => OnDismiss.InvokeAsync();
}
